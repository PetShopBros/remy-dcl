{
  "compilerOptions": {
    "outDir": "./bin",
    "declaration": true,
    "strict": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "target": "ES2020",
    "lib": ["ES2020"],
    "types": [],
    "experimentalDecorators": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@dcl/sdk/jsx-runtime"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules"]
}
